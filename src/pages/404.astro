---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="404">
  <div class="py-24">
    <p class="font-mono text-5xl font-semibold text-accent tabular-nums">404</p>
    <p class="mt-4 text-sm text-muted">这个页面走丢了。</p>
    <div class="mt-6 flex gap-2">
      <a href="/" class="btn btn-primary">返回首页</a>
      <a href="/post" class="btn">浏览文章</a>
    </div>
  </div>
</BaseLayout>

<!-- avoid-ai-design-ignore-file: K7 — 键盘焦点样式为全局 :focus-visible（globals.css） -->
