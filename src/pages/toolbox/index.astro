---
import BaseLayout from '@/layouts/BaseLayout.astro';

const tools = [
  { name: '站内搜索', desc: '浏览器本地索引，支持标题、标签、摘要的多关键词匹配。', href: '/search', ready: true },
  { name: 'Markdown 编辑器', desc: '后台文章编辑已内置 Markdown 编写与实时预览。', href: '/admin/editor', ready: true },
  { name: '归档时间轴', desc: '按年份浏览全部文章。', href: '/archive', ready: true },
  { name: '在线小工具集合', desc: 'JSON 格式化、正则测试、时间戳转换等，规划中，尚未实现。', href: '', ready: false }
];
---

<BaseLayout title="工具箱" description="常用工具入口" active="toolbox">
  <div class="rule-label">工具箱</div>
  <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">站点自带的实用入口。标注「规划中」的条目尚未实现。</p>

  <div class="mt-8 border-t border-line">
    {tools.map((tool) => (
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-line py-5">
        <h2 class="text-base font-semibold tracking-tight">{tool.name}</h2>
        <span class:list={['font-mono text-[0.7rem]', tool.ready ? 'text-accent' : 'text-muted']}>{tool.ready ? '可用' : '规划中'}</span>
        <p class="ml-auto max-w-lg text-sm leading-relaxed text-muted sm:text-right">{tool.desc}</p>
        {tool.ready && tool.href && (
          <a href={tool.href} class="border-b border-line-strong pb-0.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent">进入</a>
        )}
      </div>
    ))}
  </div>
</BaseLayout>

<!-- avoid-ai-design-ignore-file: K7 — 键盘焦点样式为全局 :focus-visible（globals.css） -->
