---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getSiteSummary, listArchive, listPosts, listTags } from '@/server/db/content';
import { listRecentComments } from '@/server/db/interactions';
import { getSiteProfile } from '@/server/db/settings';
import { formatMonth, formatNumber } from '@/lib/format';

const db = env.DB;
const [profile, latest, tags, archive, summary, recentComments] = await Promise.all([
  getSiteProfile(db),
  listPosts(db, { page: 1, pageSize: 6 }),
  listTags(db),
  listArchive(db),
  getSiteSummary(db),
  listRecentComments(db, 4)
]);

const lede = [
  { label: '篇', value: summary.postCount },
  { label: '条评论', value: summary.commentCount },
  { label: '条留言', value: summary.guestbookCount },
  { label: '字', value: summary.totalWords }
];
---

<BaseLayout title={profile.name} description={profile.bio} active="home">
  <section class="grid gap-8 border-b border-line pb-8 md:grid-cols-[1fr_15rem] md:items-end">
    <div>
      <h1 class="text-[2rem] font-semibold leading-[1.25] tracking-tight md:text-[2.6rem]">{profile.name}</h1>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">{profile.bio}</p>
      {profile.motto && <p class="mt-3 text-sm text-accent">「{profile.motto}」</p>}
    </div>

    <div class="flex items-end gap-5 md:justify-end">
      {profile.avatar && <img src={profile.avatar} alt="" width={72} height={72} class="h-16 w-16 rounded-full border border-line object-cover" loading="lazy" />}
      <dl class="flex flex-wrap gap-x-5 gap-y-1 text-xs md:flex-col md:gap-y-2 md:text-right">
        {lede.map((item) => (
          <div class="flex items-baseline gap-1.5 md:justify-end">
            <dd class="font-mono text-base font-semibold tabular-nums">{formatNumber(item.value)}</dd>
            <dt class="text-muted">{item.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {profile.announcement && (
    <aside class="mt-6 border-l-2 border-accent pl-3 text-sm leading-relaxed text-muted">
      <span class="font-medium text-accent">公告 </span>{profile.announcement}
    </aside>
  )}

  <div class="mt-10 grid gap-x-12 gap-y-12 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <div>
      <div class="rule-label">最新文章</div>
      {latest.items.length === 0 ? (
        <p class="py-12 text-sm text-muted">还没有发布的文章。</p>
      ) : (
        <div>{latest.items.map((post, index) => <ArticleCard post={post} order={index + 1} />)}</div>
      )}
      <a href="/post" class="mt-6 inline-flex items-center gap-1.5 border-b border-line-strong pb-0.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent">
        全部文章
        <span class="font-mono text-xs">{formatNumber(summary.postCount)}</span>
      </a>
    </div>

    <aside class="space-y-9">
      <section>
        <div class="rule-label">站点统计</div>
        <dl class="mt-3 text-sm">
          {[
            { label: '文章', value: summary.postCount },
            { label: '累计字数', value: summary.totalWords },
            { label: '累计阅读', value: summary.totalViews },
            { label: '评论 + 留言', value: summary.commentCount + summary.guestbookCount }
          ].map((item) => (
            <div class="rule-row">
              <dt class="text-muted">{item.label}</dt>
              <dd class="font-mono tabular-nums">{formatNumber(item.value)}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section>
        <div class="rule-label">标签云</div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.length === 0 && <p class="text-xs text-muted">暂无标签</p>}
          {tags.map((tag) => (
            <a href={`/post?tag=${tag.slug}`} class="chip">{tag.name}<span class="ml-1 font-mono text-[0.68rem] text-muted">{tag.postCount ?? 0}</span></a>
          ))}
        </div>
      </section>

      <section>
        <div class="rule-label">归档</div>
        <ul class="mt-3 text-sm">
          {archive.length === 0 && <li class="text-xs text-muted">暂无归档</li>}
          {archive.slice(0, 8).map((item) => (
            <li class="rule-row">
              <a href={`/post?year=${item.month.slice(0, 4)}&month=${item.month.slice(5, 7)}`} class="text-muted transition-colors hover:text-accent">{formatMonth(item.month)}</a>
              <span class="font-mono text-xs text-muted tabular-nums">{item.count}</span>
            </li>
          ))}
        </ul>
      </section>

      <section>
        <div class="rule-label">最新评论</div>
        <ul class="mt-3 space-y-3 text-sm">
          {recentComments.length === 0 && <li class="text-xs text-muted">暂无评论</li>}
          {recentComments.map((comment) => (
            <li class="border-b border-line pb-3 last:border-0">
              <p class="line-clamp-2 text-muted">{comment.content}</p>
              <p class="mt-1 text-xs text-muted">
                <span class="text-ink">{comment.user_name}</span> 评
                <a href={`/post/${comment.post_slug ?? ''}`} class="ml-1 transition-colors hover:text-accent">{comment.post_title}</a>
              </p>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>

