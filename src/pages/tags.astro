---
import { env } from 'cloudflare:workers';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeading from '@/components/PageHeading.astro';
import { listTags } from '@/server/db/content';

const db = env.DB;
const tags = await listTags(db);
const max = Math.max(1, ...tags.map((tag) => tag.postCount ?? 0));
---

<BaseLayout title="标签" description="全部标签" active="tags">
  <PageHeading title="主题拾取" description="不必按顺序读，从一个关键词开始就好。" meta={`${tags.length} 个标签`} />
  {tags.length === 0 ? (
    <p class="mt-4 py-12 text-sm text-muted">还没有标签。</p>
  ) : (
    <>

      <div class="mt-8 flex flex-wrap items-baseline gap-x-6 gap-y-4">
        {tags.map((tag) => {
          const ratio = (tag.postCount ?? 0) / max;
          const size = 0.88 + ratio * 0.7;
          return (
            <a href={`/post?tag=${tag.slug}`} class="group inline-flex items-baseline gap-1.5 transition-colors hover:text-accent" style={`font-size:${size}rem`}>
              <span class="text-muted group-hover:text-accent">#</span>
              <span>{tag.name}</span>
              <span class="font-mono text-[0.7rem] text-muted tabular-nums">{tag.postCount ?? 0}</span>
            </a>
          );
        })}
      </div>
    </>
  )}
</BaseLayout>

